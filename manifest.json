{
  "manifest_version": 3,
  "name": "Prism Bookmarks",
  "version": "1.0.0",
  "description": "A calm, collection-first home for your links. Organise bookmarks into spaces and collections.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Prism Bookmarks"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": ["favicon"]
}